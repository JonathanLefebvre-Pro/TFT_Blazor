@page "/movies/add"

@using BlazorApp.AppCore.Abstraction.Repositories
@using BlazorApp.Presentation.FormModels
@using BlazorApp.Presentation.Mappers

@inject IMoviesRepository MoviesService;
@inject ILogger<AddMovie> Logger
@inject NavigationManager NavManager

<EditForm OnValidSubmit="OnSubmitForm" Model="Form">
    <DataAnnotationsValidator />
    <div class="form-group row mb-1">
        <label class="col-form-label">Title :
            <InputText class="form-control" @bind-Value="Form.Title" />
        </label>
        <ValidationMessage For="() => Form.Title" />
    </div>
    <div class="form-group row mb-1">
        <label class="col-form-label">Release date :
            <InputDate class="form-control" @bind-Value="Form.ReleaseDate" />
        </label>
        <ValidationMessage For="() => Form.ReleaseDate" />
    </div>
    <div class="form-group row mb-1">
        <label class="col-form-label">Description :
            <InputTextArea class="form-control" @bind-Value="Form.Description" />
        </label>
        <ValidationMessage For="() => Form.Description" />
    </div>
    <div class="form-group row mb-1">
        <label class="col-form-label">Score :
            <InputNumber class="form-control" @bind-Value="Form.Score" />
        </label>
        <ValidationMessage For="() => Form.Score" />
    </div>
    <div class="form-group row mb-1">
        <label class="col-form-label">Duration :
            <InputNumber class="form-control" @bind-Value="Form.Duration" />
        </label>
        <ValidationMessage For="() => Form.Duration" />
    </div>
    <div class="form-group row mb-1">
        <label class="col-form-label">Image url :
            <InputText class="form-control" @bind-Value="Form.ImageUrl" />
        </label>
        <ValidationMessage For="() => Form.ImageUrl" />
    </div>
    <div class="form-group row mb-1">
        <label class="col-form-label">Directors :
            @foreach (PersonForm person in Form.Directors)
            {
                <div class="form-group col mb-1" @key="person">
                    <label class="col-form-label">FirstName :
                        <InputText class="form-control" @bind-Value="person.FirstName" />
                    </label>
                    <label class="col-form-label">LastName :
                        <InputText class="form-control" @bind-Value="person.LastName" />
                    </label>
                    <input type="button" @onclick="() => RemoveDirector(person)" value="Remove"
                           class="btn btn-primary col-form-label" />
                </div>
            }
        </label>
        <ValidationMessage For="() => Form.Directors" />
        <input type="button" @onclick="AddDirector" value="Add a director"
               class="btn btn-primary col-sm-3 col-form-label" />
    </div>
    <div class="form-group row mb-1">
        <label class="col-form-label">Writers :
            @foreach (PersonForm person in Form.Writers)
            {
                <div class="form-group col mb-1" @key="person">
                    <label class="col-form-label">FirstName :
                        <InputText class="form-control" @bind-Value="person.FirstName" />
                    </label>
                    <label class="col-form-label">LastName :
                        <InputText class="form-control" @bind-Value="person.LastName" />
                    </label>
                    <input type="button" @onclick="() => RemoveWriter(person)" value="Remove"
                           class="btn btn-primary col-form-label" />
                </div>
            }
        </label>
        <ValidationMessage For="() => Form.Writers" />
        <input type="button" @onclick="AddWriter" value="Add a writer"
               class="btn btn-primary col-sm-3 col-form-label" />
    </div>
    <input type="submit" class="btn btn-primary" />
</EditForm>

@code
{
    private AddMovieForm Form = new AddMovieForm();

    private void AddDirector()
    {
        Form.Directors.Add(new PersonForm());
    }

    private void RemoveDirector(PersonForm personForm)
    {
        Form.Directors.Remove(personForm);
    }
    
    private void AddWriter()
    {
        Form.Writers.Add(new PersonForm());
    }

    private void RemoveWriter(PersonForm personForm)
    {
        Form.Writers.Remove(personForm);
    }

    private async Task OnSubmitForm()
    {
        Logger.LogInformation("Submit form");
        int newId = await MoviesService.CreateMovie(Form.ToDto());
        NavManager.NavigateTo("/movies");
        Logger.LogInformation("New Movie created : {Id}", newId);
    }
}