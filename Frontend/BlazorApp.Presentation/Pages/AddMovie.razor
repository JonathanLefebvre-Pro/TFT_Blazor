@page "/movies/add"
@using System.ComponentModel.DataAnnotations
@using BlazorApp.AppCore.Abstraction.Repositories
@using BlazorApp.Domain.Dtos
@using BlazorApp.Domain.Entities
@inject IMoviesRepository moviesService;
@inject ILogger<AddMovie> Logger

<EditForm OnValidSubmit="OnSubmitForm" Model="Form">
    <DataAnnotationsValidator/>
    <div class="form-group row mb-1">
        <label class="col-sm-3 col-form-label">Title : 
            <InputText class="form-control" @bind-Value="Form.Title"/>
        </label>
        <ValidationMessage For="() => Form.Title"/>
    </div>
    <div class="form-group row mb-1">
        <label class="col-sm-3 col-form-label">Release date : 
            <InputDate class="form-control" @bind-Value="Form.ReleaseDate"/>
        </label>
        <ValidationMessage For="() => Form.ReleaseDate"/>
    </div>
    <div class="form-group row mb-1">
        <label class="col-sm-3 col-form-label">Description : 
            <InputTextArea class="form-control" @bind-Value="Form.Description"/>
        </label>
        <ValidationMessage For="() => Form.Description"/>
    </div>
    <div class="form-group row mb-1">
        <label class="col-sm-3 col-form-label">Score : 
            <InputNumber class="form-control" @bind-Value="Form.Score"/>
        </label>
        <ValidationMessage For="() => Form.Score"/>
    </div>
    <div class="form-group row mb-1">
        <label class="col-sm-3 col-form-label">Duration : 
            <InputNumber class="form-control" @bind-Value="Form.Duration"/>
        </label>
        <ValidationMessage For="() => Form.Duration"/>
    </div>
    <div class="form-group row mb-1">
        <label class="col-sm-3 col-form-label">Image url : 
            <InputText class="form-control" @bind-Value="Form.ImageUrl"/>
        </label>
        <ValidationMessage For="() => Form.ImageUrl"/>
    </div>
    <div class="form-group row mb-1">
        <label class="col-sm-3 col-form-label">Directors : 

        @foreach(PersonForm person in Form.Directors)
        {
            <div class="form-group row mb-1">
                <label class="col-sm-3 col-form-label">FirstName : 
                    <InputText class="form-control" @bind-Value="person.FirstName"/>
                </label>
                <input type="button" @onclick="() => RemoveDirector(person.Id)" value="Add a director" class="btn btn-primary col-sm-3 col-form-label" />
            </div>
        }
        </label>
        <ValidationMessage For="() => Form.Directors"/>
        <input type="button" @onclick="AddDirector" value="Add a director" class="btn btn-primary col-sm-3 col-form-label" />
    </div>
    <input type="submit" disabled="@(!context.Validate())" class="btn btn-primary" />
</EditForm>

@code
{
    private AddMovieForm Form { get; set; } = default!;

    protected override void OnInitialized()
    {
        Form = new AddMovieForm();
    }

    private void AddDirector()
    {
        Form.Directors.Append(new PersonForm());
    }

    private void RemoveDirector(int id)
    {
        Form.Directors.RemoveAt(id);
    }

    private async Task OnSubmitForm()
    {
        /*Logger.LogInformation("Submit form");
