@page "/movies"
@using BlazorApp.AppCore.Abstraction.Repositories
@using BlazorApp.Domain.Dtos
@using BlazorApp.Domain.Entities
@using BlazorApp.Presentation.Components;
@inject IMoviesRepository moviesService;

<a href="/movies/add">Add a new movie</a>

<table class="table table-striped">
    <thead class="thead-dark">
        <tr>
            <th scope="col">#</th>
            <th scope="col">Title</th>
            <th scope="col">Release Date</th>
            <th scope="col">Duration</th>
            <th scope="col">Score</th>
            <th scope="col"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (Movie m in MovieItems)
        {
            <MovieTableRow MovieItem="@m" OnDisplayDetails="handleDisplayDetails" />
        }
    </tbody>
</table>

@code
{
    public IEnumerable<Movie> MovieItems { get; set; } = Enumerable.Empty<Movie>();

    protected override async Task OnInitializedAsync()
    {
        IEnumerable<MovieRequestDto> moviesDto = await moviesService.GetMovies();
        List<Movie> movies = new List<Movie>();
        if(moviesDto.Count() > 0)
        {
            foreach(MovieRequestDto dto in moviesDto)
            {
                movies.Add(new Movie(
                    dto.Id,
                    dto.Title, 
                    dto.ReleaseDate,
                    dto.Description,
                    dto.Score,
                    dto.Duration,
                    dto.ImageUrl,
                    dto.Directors,
                    dto.Writers,
                    dto.Actors,
                    dto.Categories
                ));
            }
        }

        MovieItems = movies;
    }

    protected void handleDisplayDetails(int id)
    {
        Console.WriteLine("Display details for :" + id);
    }
}